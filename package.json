{
  "name": "saltbox-frontend-gateway",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "scripts": {
    "start": "webpack serve --mode=development",
    "build": "yarn clean && webpack --mode=production",
    "lint": "eslint src --ext js,ts,tsx",
    "live": "npx http-server ./dist -p 4203 --cors",
    "clean": "npx rimraf ./dist",
    "generate-api:clean": "npx rimraf api/generated",
    "generate-api:docker": "yarn generate-api:clean && yarn generate-api:docker-run",
    "generate-api:docker-run": "docker run --rm -u $(id -u ${USER}):$(id -g ${USER}) -v $PWD/src/api:/local openapitools/openapi-generator-cli generate -c /local/openapi-generator-config.json"
  },
  "devDependencies": {
    "@babel/core": "^7.23.3",
    "@babel/eslint-parser": "^7.23.3",
    "@babel/plugin-transform-runtime": "^7.23.3",
    "@babel/preset-env": "^7.23.3",
    "@babel/preset-react": "^7.23.3",
    "@babel/preset-typescript": "^7.23.3",
    "@babel/runtime": "^7.23.3",
    "babel-jest": "^27.5.1",
    "concurrently": "^6.2.1",
    "cross-env": "^7.0.3",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-config-ts-react-important-stuff": "^3.0.0",
    "eslint-plugin-prettier": "^3.4.1",
    "husky": "^7.0.2",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^27.5.1",
    "jest-cli": "^27.5.1",
    "prettier": "^2.3.2",
    "pretty-quick": "^3.1.1",
    "ts-config-single-spa": "^3.0.0",
    "typescript": "^4.3.5",
    "webpack": "^5.89.0",
    "webpack-cli": "^4.10.0",
    "webpack-config-single-spa-react-ts": "^8.0.0",
    "webpack-dev-server": "^4.0.0",
    "webpack-merge": "^5.8.0"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "@saltbox/saltbox-frontend-common": "0.0.4",
    "@saltbox/saltbox-gateway-api-client": "0.0.1-cb3edec7e64a24e8d1d3ffcb47d2829dc35c8f7e",
    "@tanstack/react-table": "^8.21.3",
    "@types/react": "^17.0.19",
    "@types/react-dom": "^17.0.9",
    "@types/systemjs": "^6.1.1",
    "@types/webpack-env": "^1.16.2",
    "antd": "^5.26.7",
    "copy-webpack-plugin": "^13.0.1",
    "css-loader": "^7.1.2",
    "i18next": "^25.5.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-http-backend": "^3.0.2",
    "mobx": "^6.13.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.7.2",
    "react-router": "^7.8.0",
    "single-spa": "^5.9.3",
    "single-spa-react": "^6.0.2"
  },
  "types": "dist/saltbox-frontend-gate.d.ts"
}
